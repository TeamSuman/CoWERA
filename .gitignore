# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# CoWERA simulation outputs (large; regenerated by runs)
**/folding_runs/
**/unfolding_runs/
**/simdata_run*/
*.h5
*.dcd

# Session artifacts (delivered to the user, not tracked in-repo)
CoWERA_session_transcript*.pdf

# Internal / development artifacts -- never part of the public release.
# (Preserved outside the repo in ../CoWERA_internal/.)
CLAUDE.md
docs/ROADMAP.md
docs/ANALYSIS_AND_OPTIMIZATION.md
docs/MANUSCRIPT_CONSISTENCY.md
docs/VALIDATION_STATUS.md

# HPC cluster automation + captured cluster results (user/cluster-specific;
# staged locally, not part of the public release)
Scripts/hpc/
Scripts/slurm/cowera_profile.sbatch

# Profiling / benchmark outputs (per-run results, regenerated by runs)
**/profile*.csv
**/gpu_util*.csv
docs/PERF_PROFILING_LOG.md

# Scratch / per-experiment configs. The canonical, shipped example for a system is
# Systems/<name>/config.yml (no suffix); every Systems/<name>/config_*.yml is a
# throwaway experiment variant, as are loose top-level Systems/*.yml and the
# launcher-generated Systems/_*.yml.
Systems/*.yml
Systems/_*.yml
Systems/*/config_*.yml
