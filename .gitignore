# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# CoWERA simulation outputs (large; regenerated by runs)
**/folding_runs/
**/unfolding_runs/
**/simdata_run*/
*.h5
*.dcd

# Session artifacts (delivered to the user, not tracked in-repo)
CoWERA_session_transcript*.pdf

# HPC cluster automation + captured cluster results (user/cluster-specific;
# staged locally, not part of the public release)
Scripts/hpc/
Scripts/slurm/cowera_profile.sbatch

# Profiling / benchmark outputs (per-run results, regenerated by runs)
**/profile*.csv
**/gpu_util*.csv
docs/PERF_PROFILING_LOG.md

# Scratch / per-experiment configs. Canonical example configs live in
# Systems/<name>/config.yml; loose top-level Systems/*.yml and config_profile*.yml
# are throwaway run configs.
Systems/*.yml
Systems/*/config_profile*.yml
